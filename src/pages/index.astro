---
import Layout from "../layouts/Layout.astro";
import BlobBackdrop from "../components/BlobBackdrop.astro";
import PhoneMockup from "../components/PhoneMockup.astro";
import WalletIllustration from "../components/icons/WalletIllustration.astro";
import DirectPayIllustration from "../components/icons/DirectPayIllustration.astro";
import FeatureIcon from "../components/FeatureIcon.astro";

// TODO: swap once billsteady-web is deployed to Cloudflare Pages. Pointed at
// the public repo for now - a real, working link, not a dead stub.
const APP_URL = "https://github.com/BillSteady/billsteady-web";

const steps = [
  {
    title: "Connect your Stellar wallet",
    body: "Freighter, Lobstr, xBull, or any Stellar wallet you already use. No new account, no seed phrase to copy down.",
  },
  {
    title: "Pick a bill",
    body: "Electricity, airtime, data, cable, school fees, a rent reference — real Nigerian billers.",
  },
  {
    title: "See the exact amount",
    body: "In naira, and in XLM or USDC at today's rate — before you confirm anything.",
  },
  {
    title: "Sign, and it's paid",
    body: "Your wallet signs the transaction. Funds go straight to the biller. We never touch your money.",
  },
];

const trustPoints = [
  {
    icon: "non-custodial" as const,
    title: "Non-custodial, always",
    body: "Your wallet, your keys. BillSteady never holds your XLM or USDC — every payment is signed by you, on your device.",
  },
  {
    icon: "multi-asset" as const,
    title: "Works with XLM and USDC",
    body: "Hold either, or both. Pay with whichever you've got — no manual swapping first.",
  },
  {
    icon: "real-billers" as const,
    title: "Real Nigerian billers",
    body: "DisCo, airtime, data, cable, school fees — not a crypto-only experiment with nowhere to spend it.",
  },
  {
    icon: "diaspora" as const,
    title: "Built for two kinds of senders",
    body: "Nigerians who already hold crypto, and family abroad sending support home — straight to a real bill, not just a wallet address.",
  },
];
---

<Layout>
  <!-- Nav -->
  <header class="sticky top-0 z-20 border-b border-brand-100/70 bg-cream/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
      <a href="#top" class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-brand-600 text-sm font-extrabold text-white">
          B
        </div>
        <span class="text-lg font-extrabold text-brand-700">BillSteady</span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-semibold text-stone-600 sm:flex">
        <a href="#how-it-works" class="hover:text-brand-700">How it works</a>
        <a href="#trust" class="hover:text-brand-700">Why it's safe</a>
      </nav>
      <a
        href={APP_URL}
        class="rounded-full bg-brand-600 px-5 py-2.5 text-sm font-bold text-white shadow-soft transition-transform hover:bg-brand-700 active:scale-95"
      >
        Connect wallet
      </a>
    </div>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="relative overflow-hidden px-5 pt-14 sm:pt-20">
      <BlobBackdrop class="-right-40 -top-40 h-[560px] w-[560px] sm:-right-20" />
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-xs font-bold text-brand-700">
            For Stellar wallet holders &middot; XLM &amp; USDC
          </p>
          <h1 class="mt-5 text-4xl font-extrabold leading-[1.1] text-stone-900 sm:text-5xl lg:text-[3.25rem]">
            Pay your Nigerian bills straight from your crypto wallet.
          </h1>
          <p class="mt-5 max-w-lg text-lg text-stone-600">
            Connect your Stellar wallet, pick a bill &mdash; DisCo, rent, school fees, data &mdash; and pay
            instantly in XLM or USDC. No off-ramp first, no middleman holding your funds.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={APP_URL}
              class="rounded-full bg-brand-600 px-7 py-3.5 text-base font-bold text-white shadow-soft transition-transform hover:bg-brand-700 active:scale-95"
            >
              Connect your wallet
            </a>
            <a href="#how-it-works" class="text-base font-bold text-brand-700 hover:text-brand-800">
              See how it works &rarr;
            </a>
          </div>
          <p class="mt-4 text-sm text-stone-500">Non-custodial. Your keys, your funds, always.</p>
        </div>
        <div class="relative">
          <PhoneMockup />
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="mx-auto mt-24 max-w-4xl px-5 text-center sm:mt-32">
      <h2 class="text-3xl font-extrabold text-stone-900 sm:text-4xl">Your crypto is real money. Spending it shouldn't take three apps.</h2>
      <div class="mt-8 grid gap-6 text-left sm:grid-cols-2">
        <p class="rounded-2xl bg-white p-5 text-stone-600 shadow-sm">
          Paying a Nigerian bill with crypto today usually means an exchange to off-ramp, a bank
          transfer, then the actual bill payment &mdash; three apps, three delays, three places something
          can go wrong.
        </p>
        <p class="rounded-2xl bg-white p-5 text-stone-600 shadow-sm">
          Family abroad sending support home hit the same wall in reverse: stablecoins arrive in
          seconds, but turning them into a paid light bill still takes days.
        </p>
        <p class="rounded-2xl bg-white p-5 text-stone-600 shadow-sm">
          Most crypto bill-pay experiences ask you to hand over custody first &mdash; send us your funds,
          trust us to pay on your behalf.
        </p>
        <p class="rounded-2xl bg-white p-5 text-stone-600 shadow-sm">
          The bill itself doesn't care how the money got there. It just needs to be paid, correctly,
          on time, by you.
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="relative mx-auto mt-24 max-w-6xl overflow-hidden px-5 sm:mt-32">
      <BlobBackdrop class="-left-52 top-20 h-[520px] w-[520px]" />
      <div class="relative text-center">
        <h2 class="text-3xl font-extrabold text-stone-900 sm:text-4xl">How BillSteady works</h2>
        <p class="mx-auto mt-3 max-w-xl text-stone-600">Four steps. No off-ramp, no bank transfer, no waiting.</p>
      </div>
      <div class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, i) => (
            <div class="rounded-2xl bg-white p-6 text-center shadow-soft">
              <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-sunrise-400 text-sm font-extrabold text-white">
                {i + 1}
              </div>
              <h3 class="mt-4 text-lg font-bold text-stone-900">{step.title}</h3>
              <p class="mt-2 text-sm text-stone-600">{step.body}</p>
            </div>
          ))
        }
      </div>
      <div class="relative mt-16 grid items-center gap-10 lg:grid-cols-2">
        <div class="mx-auto w-full max-w-sm rounded-2xl bg-white p-8 shadow-soft">
          <WalletIllustration class="mx-auto h-48 w-48" />
          <p class="mt-4 text-center text-sm font-semibold text-brand-700">Your funds stay in your own wallet</p>
        </div>
        <div class="mx-auto w-full max-w-sm rounded-2xl bg-white p-8 shadow-soft">
          <DirectPayIllustration class="mx-auto h-48 w-48" />
          <p class="mt-4 text-center text-sm font-semibold text-brand-700">Paid straight to the biller, no custody in between</p>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section id="trust" class="mx-auto mt-24 max-w-6xl px-5 sm:mt-32">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold text-stone-900 sm:text-4xl">Built so there's nothing to worry about</h2>
        <p class="mx-auto mt-3 max-w-xl text-stone-600">
          BillSteady never custodies your crypto. Your wallet signs every payment &mdash; we just connect it to a real bill.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          trustPoints.map((point) => (
            <div class="flex gap-4 rounded-2xl bg-brand-50/60 p-6">
              <div class="flex h-14 w-14 flex-none items-center justify-center rounded-xl bg-white shadow-sm">
                <FeatureIcon name={point.icon} />
              </div>
              <div>
                <h3 class="font-bold text-stone-900">{point.title}</h3>
                <p class="mt-1 text-sm text-stone-600">{point.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA footer -->
    <section class="relative mx-auto mt-24 max-w-5xl overflow-hidden rounded-[2.5rem] bg-brand-700 px-8 py-16 text-center sm:mt-32 sm:px-16">
      <BlobBackdrop class="-bottom-40 -right-40 h-[480px] w-[480px] opacity-30" />
      <div class="relative">
        <h2 class="text-3xl font-extrabold text-white sm:text-4xl">Connect your wallet and pay your next bill</h2>
        <p class="mx-auto mt-4 max-w-md text-brand-100">
          Works with XLM and USDC. Non-custodial, always. No signup beyond your wallet.
        </p>
        <a
          href={APP_URL}
          class="mt-8 inline-block rounded-full bg-sunrise-400 px-8 py-3.5 text-base font-bold text-stone-900 shadow-soft-sunrise transition-transform hover:bg-sunrise-500 active:scale-95"
        >
          Connect your wallet
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="mx-auto mt-20 max-w-6xl px-5 pb-10 pt-8 text-center text-sm text-stone-500">
      <p>BillSteady &middot; Nigeria, then Kenya and Ghana.</p>
      <p class="mt-2">
        Built in the open &mdash;
        <a href="https://github.com/BillSteady" class="font-semibold text-brand-700 hover:underline">
          github.com/BillSteady
        </a>
      </p>
    </footer>
  </main>
</Layout>
