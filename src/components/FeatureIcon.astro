---
interface Props {
  name: "non-custodial" | "multi-asset" | "real-billers" | "diaspora";
  class?: string;
}
const { name, class: className = "h-7 w-7" } = Astro.props;
---

{
  name === "non-custodial" && (
    <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 6l16 6v10c0 10-6.8 17.5-16 20-9.2-2.5-16-10-16-20V12l16-6z" stroke="var(--color-brand-700)" stroke-width="3" stroke-linejoin="round" />
      <path d="M17 24l5 5 10-11" stroke="var(--color-sunrise-500)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "multi-asset" && (
    <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="19" cy="20" r="13" fill="var(--color-brand-100)" stroke="var(--color-brand-700)" stroke-width="2.5" />
      <text x="19" y="24" font-size="8" text-anchor="middle" fill="var(--color-brand-700)" font-weight="800">XLM</text>
      <circle cx="31" cy="30" r="13" fill="var(--color-sunrise-100)" stroke="var(--color-sunrise-600)" stroke-width="2.5" />
      <text x="31" y="34" font-size="6.5" text-anchor="middle" fill="var(--color-sunrise-600)" font-weight="800">USDC</text>
    </svg>
  )
}
{
  name === "real-billers" && (
    <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="12" y="10" width="24" height="30" rx="3" stroke="var(--color-brand-700)" stroke-width="3" />
      <rect x="17" y="16" width="5" height="5" fill="var(--color-brand-200)" />
      <rect x="26" y="16" width="5" height="5" fill="var(--color-brand-200)" />
      <rect x="17" y="25" width="5" height="5" fill="var(--color-brand-200)" />
      <rect x="26" y="25" width="5" height="5" fill="var(--color-brand-200)" />
      <rect x="20" y="34" width="8" height="6" fill="var(--color-brand-600)" />
      <path d="M6 44c2-5 6-7 10-7" stroke="var(--color-sunrise-500)" stroke-width="2.5" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "diaspora" && (
    <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="20" cy="22" r="14" stroke="var(--color-brand-700)" stroke-width="3" />
      <path d="M6 22h28M20 8c3.5 4 5 8.5 5 14s-1.5 10-5 14c-3.5-4-5-8.5-5-14s1.5-10 5-14z" stroke="var(--color-brand-700)" stroke-width="2" />
      <path d="M30 30l10 10M40 30v10h-10" stroke="var(--color-sunrise-500)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
