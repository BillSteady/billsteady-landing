---
// A hand-built mockup of what the revamped app's pay flow will look like -
// not a screenshot (the real screen doesn't exist yet), so it's framed
// around the decided flow: connect wallet -> pick a bill -> see the XLM/
// USDC amount -> sign and pay, non-custodially.
---

<div class="relative mx-auto w-[260px] select-none sm:w-[300px]">
  <div class="rounded-[2.5rem] border-[8px] border-stone-900 bg-stone-900 shadow-soft">
    <div class="overflow-hidden rounded-[2rem] bg-cream-100">
      <!-- status bar -->
      <div class="flex items-center justify-between px-5 pb-1 pt-3 text-[10px] font-semibold text-stone-800">
        <span>9:41</span>
        <span>●●●●</span>
      </div>

      <!-- header -->
      <div class="flex items-center gap-2 border-b border-brand-100 bg-white px-4 py-3">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white">B</div>
        <div>
          <p class="text-sm font-bold leading-tight text-brand-700">BillSteady</p>
          <p class="text-[9px] text-stone-500">Pay a bill with XLM or USDC</p>
        </div>
      </div>

      <!-- wallet balance card -->
      <div class="m-3 rounded-xl bg-white p-3 shadow-sm">
        <p class="text-[9px] text-stone-500">Your wallet &middot; non-custodial</p>
        <div class="mt-1 flex items-center justify-between">
          <span class="text-[11px] font-bold text-brand-700">842 XLM</span>
          <span class="text-[11px] font-bold text-sunrise-600">120 USDC</span>
        </div>
      </div>

      <!-- bill picker -->
      <div class="mx-3 rounded-xl border-l-4 border-brand-600 bg-brand-50 p-3">
        <p class="text-[10px] font-bold text-brand-700">Ikeja Electric (DisCo)</p>
        <p class="mt-1 text-[9px] text-stone-600">Meter 04521 &middot; due now</p>
      </div>

      <!-- amount card -->
      <div class="mx-3 mt-3 rounded-xl bg-white p-3 shadow-sm">
        <p class="text-[9px] text-stone-500">You pay</p>
        <p class="text-lg font-extrabold text-stone-900">&#8358;18,500</p>
        <p class="text-[10px] font-semibold text-sunrise-600">&asymp; 24.6 USDC at today's rate</p>
      </div>

      <!-- pay button -->
      <div class="m-3">
        <div class="rounded-full bg-brand-600 py-2.5 text-center text-[11px] font-bold text-white shadow-sm">
          Sign &amp; pay
        </div>
        <p class="mt-1.5 text-center text-[8px] text-stone-500">Straight to the biller &middot; we never hold your funds</p>
      </div>

      <!-- tab bar -->
      <div class="flex border-t border-brand-100 bg-white px-2 py-2">
        {
          ["Wallet", "Pay a bill", "History"].map((tab, i) => (
            <div class={`flex-1 rounded-lg py-1 text-center text-[8px] font-semibold ${i === 1 ? "bg-brand-50 text-brand-700" : "text-stone-400"}`}>
              {tab}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
