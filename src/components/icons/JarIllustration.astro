---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 200 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A savings jar filling up with coins"
>
  <ellipse cx="100" cy="185" rx="70" ry="8" fill="var(--color-brand-100)" />
  <path
    d="M55 70 L55 160 Q55 175 70 175 L130 175 Q145 175 145 160 L145 70"
    stroke="var(--color-brand-700)"
    stroke-width="4"
    stroke-linejoin="round"
    fill="white"
  />
  <path d="M55 70 Q55 60 65 60 L135 60 Q145 60 145 70" stroke="var(--color-brand-700)" stroke-width="4" fill="white" />
  <rect x="50" y="48" width="100" height="16" rx="8" fill="var(--color-brand-600)" />
  <rect x="80" y="32" width="40" height="18" rx="6" fill="var(--color-brand-700)" />

  <!-- fill level -->
  <path
    d="M58 150 Q58 165 70 165 L130 165 Q142 165 142 150 L142 115 L58 115 Z"
    fill="var(--color-brand-100)"
  />

  <!-- coins -->
  <circle cx="80" cy="130" r="13" fill="var(--color-sunrise-400)" stroke="var(--color-sunrise-600)" stroke-width="2" />
  <circle cx="108" cy="122" r="13" fill="var(--color-sunrise-400)" stroke="var(--color-sunrise-600)" stroke-width="2" />
  <circle cx="98" cy="146" r="13" fill="var(--color-sunrise-500)" stroke="var(--color-sunrise-600)" stroke-width="2" />
  <text x="80" y="135" font-size="11" text-anchor="middle" fill="var(--color-sunrise-600)" font-weight="700">&#8358;</text>
  <text x="108" y="127" font-size="11" text-anchor="middle" fill="var(--color-sunrise-600)" font-weight="700">&#8358;</text>

  <!-- a coin dropping in -->
  <circle cx="100" cy="20" r="11" fill="var(--color-sunrise-400)" stroke="var(--color-sunrise-600)" stroke-width="2" />
  <text x="100" y="24" font-size="10" text-anchor="middle" fill="var(--color-sunrise-600)" font-weight="700">&#8358;</text>
</svg>
