---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 200 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A calendar showing bills due before payday"
>
  <rect x="30" y="40" width="140" height="130" rx="16" fill="white" stroke="var(--color-brand-700)" stroke-width="4" />
  <rect x="30" y="40" width="140" height="34" rx="16" fill="var(--color-brand-600)" />
  <rect x="30" y="58" width="140" height="16" fill="var(--color-brand-600)" />
  <rect x="55" y="26" width="10" height="28" rx="5" fill="var(--color-brand-700)" />
  <rect x="135" y="26" width="10" height="28" rx="5" fill="var(--color-brand-700)" />

  <!-- grid of days -->
  <g stroke="var(--color-brand-100)" stroke-width="2">
    <line x1="30" y1="100" x2="170" y2="100" />
    <line x1="30" y1="128" x2="170" y2="128" />
    <line x1="30" y1="156" x2="170" y2="156" />
    <line x1="65" y1="74" x2="65" y2="170" />
    <line x1="100" y1="74" x2="100" y2="170" />
    <line x1="135" y1="74" x2="135" y2="170" />
  </g>

  <!-- payday marker -->
  <circle cx="152" cy="142" r="13" fill="var(--color-brand-500)" />
  <path d="M146 142 L150 147 L159 137" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

  <!-- a short/at-risk bill marker -->
  <circle cx="82" cy="114" r="13" fill="var(--color-sunrise-400)" stroke="var(--color-sunrise-600)" stroke-width="2" />
  <text x="82" y="119" font-size="14" text-anchor="middle" fill="white" font-weight="700">!</text>
</svg>
